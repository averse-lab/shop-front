{
  "extends": [
    "next/core-web-vitals",
    "prettier",
    "plugin:import/errors",
    "plugin:import/typescript"
  ],
  "settings": {
    "import/resolver": {
      "typescript": true
    }
  },
  "rules": {
    "import/order": [
      "error",
      {
        "groups": [
          "builtin",
          "external",
          "internal",
          ["parent", "sibling"],
          "object",
          "type",
          "index"
        ],
        "pathGroups": [
          {
            "pattern": "{react,react-dom/**}",
            "group": "external",
            "position": "before"
          }
        ],
        "distinctGroup": true,
        "pathGroupsExcludedImportTypes": ["react"],
        "newlines-between": "always",
        "alphabetize": {
          "order": "asc",
          "caseInsensitive": true
        }
      }
    ]
  }
}
